# Copia este fichero a .env y pon la clave. El .env no se sube.

# Clave del usuario meteoscan en la base de desarrollo. Solo letras y numeros:
# en este fichero, un $ se lee como una variable, y un # detras de un espacio,
# como un comentario. Solo cuenta al crear el volumen (ver compose.yaml).
DB_PASSWORD=

# Donde esta la base de desarrollo, para la API. Los mismos valores que
# compose.yaml: si cambian alli, cambian aqui.
DB_HOST=127.0.0.1
DB_PORT=5438
DB_USER=meteoscan
DB_NAME=meteoscan
